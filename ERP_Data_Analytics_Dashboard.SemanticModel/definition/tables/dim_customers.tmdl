	column 'Age Bucket' =
			VAR Age =
			    DATEDIFF ( dim_customers[birth_date], TODAY (), YEAR )
			RETURN
			    IF (
			        ISBLANK ( dim_customers[birth_date] ),
			        "Unknown",
			        SWITCH (
			            TRUE (),
			            Age < 25, "Under 25",
			            Age < 35, "25-34",
			            Age < 45, "35-44",
			            Age < 55, "45-54",
			            "55+"
			        )
			    )
		dataType: string
		lineageTag: 1ca2a6c5-de2e-4a38-bb5c-bee1a3ad9e0f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

